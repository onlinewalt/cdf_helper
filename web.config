<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS deployment configuration for CDF Helper (Flask app).
  
  Prerequisites on the Windows Server:
  1. Python 3.9+ installed (e.g. C:\Python313\python.exe)
  2. wfastcgi installed and enabled:
      python -m pip install wfastcgi
      python -m wfastcgi-enable
  3. Project dependencies installed:
      pip install -r requirements.txt
  
  IMPORTANT: You must set the correct Python and wfastcgi paths in the
  "scriptProcessor" attribute below. Run `python -m wfastcgi-enable`
  to get the recommended scriptProcessor value, then paste it here.
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Python FastCGI handler -->
      <add name="PythonHandler" path="*" verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\Python313\python.exe|C:\Python313\lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
    <httpErrors errorMode="Detailed" />
  </system.webServer>

  <appSettings>
    <!-- WSGI application callable: webapp.py exposes `app = Flask(__name__)` -->
    <add key="WSGI_HANDLER" value="webapp.app" />

    <!-- Project root directory (absolute path to the app folder) -->
    <add key="PYTHONPATH" value="." />

    <!-- Restart the app when web.config or any .py file changes (empty = off) -->
    <add key="WSGI_RESTART_FILE_REGEX" value="" />

    <!-- Log file for wfastcgi errors (ensure IIS has write permission) -->
    <add key="WSGI_LOG" value="logs\wfastcgi.log" />

    <!-- Environment variables -->
    <add key="WSGI_ENVIRONMENT" value="production" />
  </appSettings>
</configuration>
